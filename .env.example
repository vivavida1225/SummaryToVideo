# Copy to .env only if it does not already exist. Gemini keys are used in number order.
# OpenAI uses a nonempty process environment value first, then this file.
OPENAI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# InfoX backend only. Process environment overrides this file; never commit .env.
# INFOX_USERNAME is the email sent in the login JSON. Quotes preserve special characters.
INFOX_USERNAME=
INFOX_PASSWORD=
# Existing video for the read-only connection probe (never creates a video).
INFOX_VIDEO_ID=
# Optional: use a current access token or organization device credential instead of login.
INFOX_ACCESS_TOKEN=
INFOX_ORG_DEVICE_TOKEN=
